#!/bin/bash

set -e  # Exit on error

FORCE=false
if [[ "$1" == "--force" ]]; then
  FORCE=true
fi

# Detect architecture
case "$(uname -m)" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  *) echo "❌ Unsupported architecture: $(uname -m)"; exit 1 ;;
esac

echo "🧠 Architecture detected: $ARCH"

### ─────────────────────────────────────────────
### 🚀 Install Cilium CLI
### ─────────────────────────────────────────────

if command -v cilium >/dev/null 2>&1 && [ "$FORCE" = false ]; then
  echo "⚠️  Cilium CLI is already installed at $(command -v cilium). Use --force to reinstall."
else
  echo "📦 Installing Cilium CLI..."
  CILIUM_CLI_VERSION=$(curl -s https://raw.githubusercontent.com/cilium/cilium-cli/main/stable.txt)
  curl -L --fail --remote-name-all \
    https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${ARCH}.tar.gz{,.sha256sum}
  sha256sum --check cilium-linux-${ARCH}.tar.gz.sha256sum
  sudo tar xzvfC cilium-linux-${ARCH}.tar.gz /usr/local/bin
  rm cilium-linux-${ARCH}.tar.gz{,.sha256sum}
  echo "✅ Cilium CLI installed."
fi

### ─────────────────────────────────────────────
### 🔭 Install Hubble CLI
### ─────────────────────────────────────────────

if command -v hubble >/dev/null 2>&1 && [ "$FORCE" = false ]; then
  echo "⚠️  Hubble CLI is already installed at $(command -v hubble). Use --force to reinstall."
else
  echo "📡 Installing Hubble CLI..."
  HUBBLE_VERSION=$(curl -s https://raw.githubusercontent.com/cilium/hubble/master/stable.txt)
  curl -L --fail --remote-name-all \
    https://github.com/cilium/hubble/releases/download/$HUBBLE_VERSION/hubble-linux-${ARCH}.tar.gz{,.sha256sum}
  sha256sum --check hubble-linux-${ARCH}.tar.gz.sha256sum
  sudo tar xzvfC hubble-linux-${ARCH}.tar.gz /usr/local/bin
  rm hubble-linux-${ARCH}.tar.gz{,.sha256sum}
  echo "✅ Hubble CLI installed."
fi

### ✅ Verify installation
echo
echo "🔍 Installed versions:"
cilium version --client && hubble version
